{
    "name": "f-react-hooks",
    "version": "0.0.1",
    "main": "index.js",
    "packageManager": "pnpm@10.33.4",
    "scripts": {
        "lint": "eslint \"{packages,apps}/**/*.{js,jsx,ts,tsx}\"",
        "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
        "typecheck": "tsc --noEmit",
        "commit": "git-cz",
        "prepare": "husky",
        "build": "turbo run build",
        "dev": "turbo run dev",
        "test": "pnpm --filter=./packages/* test",
        "test:cov": "cross-env REACT_MODE=strict pnpm --filter=./packages/* test:cov"
    },
    "keywords": [],
    "author": "",
    "license": "",
    "description": "",
    "lint-staged": {
        "**/*.{js,jsx}": [
            "eslint --fix",
            "prettier --cache --write"
        ],
        "**/*.{ts,tsx}": [
            "eslint --fix",
            "prettier --cache --write --parser=typescript"
        ]
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git"
        }
    },
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^25.6.0",
        "eslint": "^10.3.0",
        "@eslint/js": "^10.0.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.43.0",
        "globals": "^17.6.0",
        "prettier": "^3.6.2",
        "eslint-plugin-prettier": "^5.5.5",
        "lint-staged": "^17.0.2",
        "cspell": "^10.0.0",
        "commitlint": "^20.5.3",
        "commitizen": "^4.3.1",
        "cz-git": "^1.12.0",
        "husky": "^9.1.7",
        "turbo": "^2.5.6",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "vitest": "^4.1.5",
        "@vitest/coverage-istanbul": "^4.1.5",
        "jsdom": "^29.1.1",
        "cross-env": "^10.1.0",
        "@testing-library/react": "^16.3.0",
        "vite": "^8.0.11",
        "tsup": "^8.5.1",
        "@swc/core": "^1.15.33"
    }
}
